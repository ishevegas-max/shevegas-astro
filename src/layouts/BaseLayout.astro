---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SheVegas — Michael Brunette's visual publication",
  description = "Sheboygan, seen from inside SheVegas. Original art, photography, civic records, sound and memory by Michael Brunette.",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#050505" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
